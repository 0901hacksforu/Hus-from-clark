-- Right Shift Toggle Logic with Animation
local guiVisible = true
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.RightShift then
        guiVisible = not guiVisible
        
        local targetSize = guiVisible and UDim2.new(0, 320, 0, 380) or UDim2.new(0, 0, 0, 0)
        local targetTransparency = guiVisible and 0 or 1
        
        local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        
        TweenService:Create(mainFrame, tweenInfo, {Size = targetSize}):Play()
        TweenService:Create(uiStroke, tweenInfo, {Transparency = targetTransparency}):Play()
        
        for _, child in ipairs(mainFrame:GetChildren()) do
            if child:IsA("TextLabel") or child:IsA("TextBox") or child:IsA("TextButton") then
                TweenService:Create(child, tweenInfo, {BackgroundTransparency = guiVisible and (child:IsA("TextLabel") and 1 or 0) or 1}):Play()
                if not child:IsA("UICorner") and not child:IsA("UIStroke") and not child:IsA("UIScale") then
                    child.Visible = guiVisible
                end
            end
        end
    end
end)
