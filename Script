-- Isolated Hitbox Expansion (Only expands HumanoidRootPart without changing visual body scale)
applyBtn.MouseButton1Click:Connect(function()
    local num = tonumber(inputBox.Text)
    if num then
        if num < 0.01 then num = 0.01 end
        if num > 20 then num = 20 end
        valueDisplay.Text = "Hitbox Size: " .. tostring(num)
        
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            hrp.Size = Vector3.new(num, num, num)
            hrp.Transparency = 0.7 -- Slight visibility to see your range area, set to 1 for fully invisible
            hrp.CanCollide = false  -- Prevents getting stuck or floating due to oversized block
        end
    end
end)

-- Re-apply size when character character respawns
player.CharacterAdded:Connect(function(char)
    local num = tonumber(inputBox.Text)
    if num and num ~= 2 then
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if hrp then
            hrp.Size = Vector3.new(num, num, num)
            hrp.Transparency = 0.7
            hrp.CanCollide = false
        end
    end
end)

